#!/bin/bash
# CRC: crc-LinkappScript.md | R85, R184, R185, R186, R187, R188
# linkapp - Activate or deactivate a ui-engine app
#
# Usage:
#   linkapp add <app>     Activate app (link lua/<app> to its directory)
#   linkapp remove <app>  Deactivate app
#   linkapp list          List active apps
#
# An app is active when lua/<app> links to apps/<app>; ui-engine reads the
# entry file, modules and viewdefs through that one link.

set -e

BASE_DIR=$(dirname "$(realpath "$0")")
APPS_DIR="$BASE_DIR/apps"
LUA_DIR="$BASE_DIR/lua"
VIEWDEFS_DIR="$BASE_DIR/viewdefs" # only for cleaning up old-scheme links

usage() {
    echo "Usage: linkapp <command> [app]"
    echo ""
    echo "Commands:"
    echo "  add <app>     Activate app (link lua/<app> to its directory)"
    echo "  remove <app>  Deactivate app"
    echo "  list          List active apps"
    exit 1
}

check_app_exists() {
    local app="$1"
    if [[ ! -d "$APPS_DIR/$app" ]]; then
        echo "Error: App '$app' not found in $APPS_DIR/"
        exit 1
    fi
}

# R188: remove links from the old per-file scheme
remove_old_links() {
    local app="$1"
    if [[ -L "$LUA_DIR/$app.lua" ]]; then
        rm "$LUA_DIR/$app.lua"
        echo "Removed old link: $LUA_DIR/$app.lua"
    fi
    [[ -d "$VIEWDEFS_DIR" ]] || return 0
    for f in "$VIEWDEFS_DIR"/*.html; do
        [[ -L "$f" ]] || continue
        if [[ "$(readlink "$f")" == *"/apps/$app/viewdefs/"* ]]; then
            rm "$f"
            echo "Removed old link: $f"
        fi
    done
}

# R184, R187, R85
add_app() {
    local app="$1"
    check_app_exists "$app"
    mkdir -p "$LUA_DIR"
    ln -sfn "../apps/$app" "$LUA_DIR/$app"
    echo "Linked: $LUA_DIR/$app"
    remove_old_links "$app"
    echo "Done: $app active"
}

# R185
remove_app() {
    local app="$1"
    if [[ -L "$LUA_DIR/$app" ]]; then
        rm "$LUA_DIR/$app"
        echo "Removed: $LUA_DIR/$app"
    fi
    remove_old_links "$app"
    echo "Done: $app inactive"
}

# R186
list_apps() {
    echo "Active apps:"
    for f in "$LUA_DIR"/*; do
        [[ -L "$f" && -d "$f" ]] || continue
        echo "  $(basename "$f")"
    done
}

# Main
case "${1:-}" in
    add)
        [[ -n "${2:-}" ]] || usage
        add_app "$2"
        ;;
    remove)
        [[ -n "${2:-}" ]] || usage
        remove_app "$2"
        ;;
    list)
        list_apps
        ;;
    *)
        usage
        ;;
esac
